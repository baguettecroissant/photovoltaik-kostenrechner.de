---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../../site.config';
import { brands } from '../../data/brands';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Hersteller von Solaranlagen & Batteriespeichern",
    "description": "Vergleichen Sie die besten Solarmodul- und Wechselrichter-Marken: Meyer Burger, Solarwatt, SMA Solar, Fronius, Senec und JinkoSolar.",
    "url": "https://" + siteConfig.domain + "/hersteller",
  }
];
---

<BaseLayout
  title={`Hersteller-Vergleich 2026: Die besten Solarmarken | ${siteConfig.name}`}
  description={`Welches Solarmodul ist das beste? Meyer Burger, Solarwatt oder JinkoSolar? Welcher Wechselrichter passt? Vergleich von Preisen, Leistung & Garantien.`}
  canonical="/hersteller"
  jsonLd={jsonLd}
>
  <section class="gradient-hero text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Hersteller", href: "/hersteller" },
      ]} />
      <h1 class="text-3xl md:text-5xl font-extrabold mb-4 font-heading mt-6">
        🏆 Solarmodul- & Speicher-Hersteller im Vergleich 2026
      </h1>
      <p class="text-blue-100 text-lg max-w-2xl">
        Finden Sie die passenden Komponenten für Ihre Photovoltaikanlage. Vergleichen Sie führende Hersteller nach Leistung, Garantie und Preis.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {brands.map((b) => (
        <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden flex flex-col justify-between card-hover">
          <div class="p-6 space-y-4">
            <!-- Brand Badge -->
            <div class="flex justify-between items-center">
              <span class="text-xs font-semibold text-amber-600 uppercase tracking-wider bg-amber-50 px-2.5 py-1 rounded-md">
                {b.positioning}
              </span>
              <span class="text-xs font-medium text-gray-500 flex items-center gap-1">
                {b.flag} {b.country}
              </span>
            </div>

            <!-- Title -->
            <h2 class="text-2xl font-bold text-gray-900 font-heading">
              {b.name}
            </h2>

            <!-- Excerpt -->
            <p class="text-xs text-gray-600 leading-relaxed line-clamp-3">
              {b.description}
            </p>

            <!-- Metadata info -->
            <div class="bg-gray-50 p-3.5 rounded-xl text-xs space-y-1.5 border border-gray-200">
              <div class="flex justify-between">
                <span class="text-gray-500">Flaggschiff:</span>
                <span class="font-bold text-gray-800">{b.flagship}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">Richtpreis:</span>
                <span class="font-bold text-amber-600 font-data">{b.priceRange}</span>
              </div>
            </div>
          </div>

          <div class="bg-gray-50 p-5 border-t border-gray-100 flex items-center justify-between">
            <span class="text-xs text-gray-500">Garantie: {b.warranty.split(',')[0]}</span>
            <a href={`/hersteller/${b.slug}`} class="cta-gradient text-white text-xs font-bold px-4 py-2 rounded-lg shadow-sm hover:shadow-md transition-all">
              Testbericht & Infos →
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Cross-links: Guides -->
    <div class="mt-12 bg-white rounded-2xl border border-gray-200 p-6 md:p-8 shadow-sm">
      <h2 class="text-xl font-bold text-gray-900 mb-4 font-heading">📚 Relevante Ratgeber</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/ratgeber/photovoltaik-rechner-vs-beratung" class="bg-gray-50 rounded-xl p-4 border border-gray-100 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">⭐</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">Online-Rechner vs. Beratung</span>

        </a>
        <a href="/ratgeber/solaranlage-kosten-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-100 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">💰</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">Preise für Solaranlagen 2026</span>
        </a>
        <a href="/ratgeber/photovoltaik-foerderung-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-100 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">🏛️</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">PV-Förderung & Zuschüsse</span>
        </a>
      </div>
    </div>

    <!-- Cross-links: Rechner + FAQ -->
    <div class="mt-6 grid sm:grid-cols-2 gap-4">
      <a href="/kostenrechner" class="bg-blue-900 text-white rounded-2xl border border-blue-950 p-6 hover:bg-blue-800 transition-all group shadow-md">
        <span class="text-2xl block mb-2">🧮</span>
        <h3 class="font-bold text-lg font-heading text-amber-300 group-hover:text-amber-200">Kostenrechner</h3>
        <p class="text-xs text-blue-200/80 mt-2">Berechnen Sie die Preise und Autarkie für Ihr Dach in 2 Minuten.</p>
      </a>
      <a href="/faq" class="bg-white rounded-2xl border border-gray-200 p-6 hover:border-amber-400 hover:shadow-md transition-all group">
        <span class="text-2xl block mb-2">❓</span>
        <h3 class="font-bold text-lg font-heading text-gray-900 group-hover:text-amber-600">Häufige Fragen (FAQ)</h3>
        <p class="text-xs text-gray-600 mt-2">Ausführliche Experten-Antworten zu Steuern, Einspeisung und Preisen.</p>
      </a>
    </div>
  </section>
</BaseLayout>
