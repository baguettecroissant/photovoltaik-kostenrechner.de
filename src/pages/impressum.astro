---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../../site.config';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Impressum - " + siteConfig.name,
    "url": "https://" + siteConfig.domain + "/impressum",
  }
];
---

<BaseLayout title={`Impressum | ${siteConfig.name}`} description={`Rechtliche Angaben und Impressum für ${siteConfig.domain}.`} canonical="/impressum" jsonLd={jsonLd}>
  <section class="gradient-hero text-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Impressum", href: "/impressum" },
      ]} />
      <h1 class="text-3xl md:text-4xl font-extrabold mb-4 font-heading mt-6">
        Impressum
      </h1>
      <p class="text-blue-100">Rechtliche Hinweise und Anbieterangaben</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="bg-white rounded-2xl border border-gray-200 p-6 md:p-8 shadow-sm space-y-6 text-gray-700 text-sm md:text-base leading-relaxed">
      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-heading">Anbieterangaben</h2>
        <p>
          <strong>Wade Studio Ltd.</strong><br />
          432 Ave Bounty<br />
          Balaclava 20104<br />
          Mauritius
        </p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-heading">Vertreten durch</h2>
        <p>Timothy Wade</p>
      </div>

      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-heading">Kontakt</h2>
        <p>E-Mail: <a href="mailto:wadestudioltd@gmail.com" class="underline">wadestudioltd@gmail.com</a></p>
      </div>

      <hr class="border-gray-100" />

      <div>
        <h2 class="text-lg font-bold text-gray-900 mb-2 font-heading">Haftung für Inhalte und Links</h2>
        <p class="text-xs md:text-sm">
          Die Inhalte dieser Website werden mit Sorgfalt erstellt. Eine Gewähr für ihre Richtigkeit, Vollständigkeit und Aktualität wird nur im gesetzlich vorgesehenen Umfang übernommen.
        </p>
        <p class="text-xs md:text-sm mt-3">
          Diese Website kann Links zu externen Websites enthalten, auf deren Inhalte wir keinen Einfluss haben. Für die Inhalte verlinkter Seiten ist der jeweilige Anbieter oder Betreiber verantwortlich.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
