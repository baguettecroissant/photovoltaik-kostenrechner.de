    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-4">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-1 font-heading">🗺️ Standort & Solarpotenzial — {city.name} ({city.zip})</h2>
      <p class="text-sm text-gray-600">
        Ihr Standort in {city.name}, {city.bundesland}. Mit {city.sonnenstunden} Sonnenstunden pro Jahr und einem spezifischen Ertrag von {spezErtrag} kWh/kWp bietet die Region {solarRanking.label}e Bedingungen für Photovoltaik.
      </p>
      
      <div id="solar-map" class="h-64 md:h-80 w-full rounded-xl border border-gray-200 shadow-inner z-10"></div>
      <p class="text-[11px] text-gray-400 text-center">
        Kartendaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow" class="underline">OpenStreetMap</a>-Mitwirkende.
      </p>

      <script is:inline define:vars={{ lat: city.lat, lng: city.lng, cityName: city.name, zip: city.zip, ertrag: spezErtrag, sonnenstunden: city.sonnenstunden, bundesland: city.bundesland }}>
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof L !== 'undefined' && document.getElementById('solar-map')) {
            const map = L.map('solar-map', { scrollWheelZoom: false }).setView([lat, lng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '© OpenStreetMap'
            }).addTo(map);
            
            // Solar coverage circle (10 km radius)
            L.circle([lat, lng], {
              radius: 10000,
              fillColor: '#FFAB00',
              color: '#FF6D00',
              weight: 1.5,
              opacity: 0.5,
              fillOpacity: 0.08
            }).addTo(map);

            // City marker
            L.circleMarker([lat, lng], {
              radius: 10,
              fillColor: '#FF6D00',
              color: '#FFFFFF',
              weight: 2.5,
              opacity: 1,
              fillOpacity: 0.95
            }).addTo(map)
              .bindPopup(
                '<div style="min-width:180px">' +
                '<b style="font-size:14px">☀️ ' + cityName + '</b><br>' +
                '<span style="color:#666">PLZ: ' + zip + ' • ' + bundesland + '</span><br>' +
                '<hr style="margin:6px 0;border-color:#eee">' +
                '<b>Sonnenstunden:</b> ' + sonnenstunden + ' h/Jahr<br>' +
                '<b>Spez. Ertrag:</b> ' + ertrag + ' kWh/kWp<br>' +
                '<b>10 kWp Ertrag:</b> ' + (ertrag * 10).toLocaleString('de-DE') + ' kWh/Jahr' +
                '</div>'
              )
              .openPopup();
          }
        });
      </script>
    </section>

    <!-- Block 8: Förderungen -->
